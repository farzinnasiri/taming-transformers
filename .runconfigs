# Docker run options
# Add --cpuset-cpus="0-15" to pin to specific cores
docker_args: -v /home/nasiri/storage/vq-gan/checkpoints:/checkpoints -v /home/nasiri/datasets/shared/imagenet:/datasets/imagenet -p 7677:8888 --shm-size=8g
# Specify the name of the container
container_name: "{user}_vqgan_GPU{args.gpu}_{date}"

# Specify the Docker image to use
image_name: nasiri/taming:latest